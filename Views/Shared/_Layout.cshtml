@{
    // Current user's avatar/name for the header (FotoPerfil claim is set at sign-in/profile edit).
    var headerPhoto = User.FindFirst("FotoPerfil")?.Value;
    var headerName = User.Identity?.Name ?? "";
    var headerInitial = !string.IsNullOrEmpty(headerName) ? headerName.Substring(0, 1).ToUpper() : "?";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AnyComic</title>
    <link rel="icon" type="image/x-icon" href="~/icon.ico" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#e63946" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="AnyComic" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AnyComic.styles.css" asp-append-version="true" />
    <style>
        /* Header live search — subtle field that blends into the navbar */
        .header-search { position: relative; margin-left: auto; margin-right: 16px; }
        .mobile-search-toggle, .mobile-header-search { display: none; }
        .header-search-box {
            display: flex; align-items: center; gap: 8px;
            background: rgba(255, 255, 255, .05);
            border: 1px solid rgba(255, 255, 255, .09);
            border-radius: 10px; padding: 8px 14px; min-width: 300px;
            transition: background .2s, border-color .2s, box-shadow .2s;
        }
        .header-search-box:hover { background: rgba(255, 255, 255, .08); }
        .header-search-box:focus-within {
            background: rgba(255, 255, 255, .08);
            border-color: rgba(230, 57, 70, .65);
            box-shadow: 0 0 0 3px rgba(230, 57, 70, .15);
        }
        .header-search-icon { color: rgba(255, 255, 255, .4); flex-shrink: 0; }
        .header-search-box:focus-within .header-search-icon { color: var(--primary-red, #e63946); }
        .header-search-input {
            background: transparent; border: none; outline: none;
            color: var(--text-primary, #f0f0f0); font-size: 14px; width: 100%; padding: 0;
        }
        .header-search-input::placeholder { color: rgba(255, 255, 255, .38); }
        .header-search-dropdown {
            position: absolute; top: calc(100% + 8px); left: 0; right: 0; min-width: 340px;
            background: var(--bg-darker, #1a1a1a);
            border: 1px solid var(--border-color, #3a3a3a);
            border-radius: 10px; box-shadow: 0 12px 32px rgba(0, 0, 0, .55);
            overflow: hidden auto; max-height: 460px; display: none; z-index: 1050;
        }
        .header-search-dropdown.open { display: block; }
        .header-search-item {
            display: flex; align-items: center; gap: 12px; padding: 10px 14px;
            text-decoration: none; color: var(--text-primary, #f0f0f0); transition: background .15s;
        }
        .header-search-item:hover, .header-search-item.active { background: rgba(255, 255, 255, .06); }
        .header-search-thumb {
            width: 44px; height: 60px; object-fit: cover; border-radius: 5px;
            flex-shrink: 0; background: var(--bg-light, #2a2a2a);
        }
        .header-search-info { min-width: 0; }
        .header-search-title {
            font-size: 14px; font-weight: 600;
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
        }
        .header-search-author {
            font-size: 12px; color: var(--text-secondary, #b0b0b0);
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
        }
        .header-search-empty { padding: 16px 14px; font-size: 13px; color: var(--text-muted, #808080); text-align: center; }
        @@media (max-width: 991.98px) {
            header { position: relative; z-index: 1040; }
            header .navbar { padding: 5px 0; min-height: 46px; }
            header .navbar .container-fluid {
                position: relative; justify-content: space-between; gap: 8px; padding-inline: 12px;
            }
            header .navbar-brand { flex: 0 0 auto; font-size: 1rem; line-height: 1; }
            .mobile-search-toggle {
                display: grid; place-items: center; width: 36px; height: 36px; padding: 0;
                color: rgba(255, 255, 255, .72); background: transparent;
                border: 1px solid rgba(255, 255, 255, .1); border-radius: 50%;
                transition: color .18s, background .18s, border-color .18s;
                -webkit-tap-highlight-color: transparent;
            }
            .mobile-search-toggle:hover, .mobile-search-toggle:focus-visible,
            .mobile-search-toggle[aria-expanded="true"] {
                color: #fff; background: rgba(255, 255, 255, .08);
                border-color: rgba(230, 57, 70, .55); outline: none;
            }
            .mobile-header-search {
                position: absolute; top: calc(100% + 6px); left: 12px; right: 12px;
                display: block; margin: 0; padding: 8px;
                background: rgba(24, 24, 24, .98); border: 1px solid rgba(255, 255, 255, .1);
                border-radius: 12px; box-shadow: 0 14px 36px rgba(0, 0, 0, .5);
                opacity: 0; visibility: hidden; transform: translateY(-6px); pointer-events: none;
                transition: opacity .18s ease, transform .18s ease, visibility .18s;
            }
            .mobile-header-search.open {
                opacity: 1; visibility: visible; transform: translateY(0); pointer-events: auto;
            }
            .mobile-header-search .header-search-box {
                min-width: 0; height: 42px; padding: 7px 8px 7px 11px;
                border-radius: 9px; background: rgba(255, 255, 255, .07);
            }
            .mobile-header-search .header-search-input { font-size: 16px; }
            .mobile-search-close {
                display: grid; place-items: center; flex: 0 0 30px; width: 30px; height: 30px;
                padding: 0; color: rgba(255, 255, 255, .55); background: transparent;
                border: 0; border-radius: 50%;
            }
            .mobile-search-close:hover, .mobile-search-close:focus-visible {
                color: #fff; background: rgba(255, 255, 255, .08); outline: none;
            }
            .mobile-header-search .header-search-dropdown {
                top: calc(100% + 6px); right: 0; left: 0; width: auto; min-width: 0;
                max-height: min(55vh, 420px); border-radius: 9px;
            }
            .mobile-header-search .header-search-item { min-height: 64px; padding: 8px 10px; }
            .mobile-header-search .header-search-thumb { width: 36px; height: 50px; }
        }
        @@media (max-width: 380px) {
            header .navbar .container-fluid { padding-inline: 10px; }
            header .navbar-brand { font-size: .95rem; letter-spacing: 0; }
            .mobile-header-search { left: 10px; right: 10px; }
        }
    </style>
</head>
<body>
    <!-- Navigation Bar - HotComics Style -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-light">
            <div class="container-fluid" style="max-width: 1400px; margin: 0 auto;">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">AnyComic</a>
                <button type="button" class="mobile-search-toggle" aria-label="Open search"
                        aria-controls="mobileHeaderSearch" aria-expanded="false" data-mobile-search-toggle>
                    <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/>
                    </svg>
                </button>
                <div class="header-search mobile-header-search" id="mobileHeaderSearch" data-live-search>
                    <form class="header-search-box" method="get" asp-controller="Manga" asp-action="Index" role="search" autocomplete="off">
                        <svg class="header-search-icon" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/>
                        </svg>
                        <input type="search" name="searchTerm" class="header-search-input"
                               placeholder="Search manga..." aria-label="Search manga" aria-autocomplete="list"
                               aria-expanded="false" enterkeyhint="search" autocomplete="off" data-search-input />
                        <button type="button" class="mobile-search-close" aria-label="Close search" data-mobile-search-close>
                            <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708"/>
                            </svg>
                        </button>
                    </form>
                    <div class="header-search-dropdown" role="listbox" aria-label="Manga suggestions" data-search-dropdown></div>
                </div>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Manga" asp-action="Index">Manga</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Anime" asp-action="Index">
                                Anime <span style="font-size:10px;font-weight:700;background:#ef2c2f;color:#fff;padding:1px 6px;border-radius:4px;vertical-align:middle;letter-spacing:.5px;">BETA</span>
                            </a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true && !User.Claims.Any(c => c.Type == "IsAdmin" && c.Value == "True"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Manga" asp-action="Favoritos">Favorites</a>
                            </li>
                        }
                    </ul>
                    <div class="header-search" data-live-search>
                        <form class="header-search-box" method="get" asp-controller="Manga" asp-action="Index" role="search" autocomplete="off">
                            <svg class="header-search-icon" xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/>
                            </svg>
                            <input type="search" name="searchTerm" class="header-search-input"
                                   placeholder="Search manga..." aria-label="Search manga" aria-autocomplete="list"
                                   aria-expanded="false" enterkeyhint="search" autocomplete="off" data-search-input />
                        </form>
                        <div class="header-search-dropdown" role="listbox" aria-label="Manga suggestions" data-search-dropdown></div>
                    </div>
                    <ul class="navbar-nav header-profile-nav">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle nav-profile-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    @if (!string.IsNullOrEmpty(headerPhoto))
                                    {
                                        <img src="@headerPhoto" alt="@headerName" class="nav-avatar" />
                                    }
                                    else
                                    {
                                        <span class="nav-avatar nav-avatar-ph">@headerInitial</span>
                                    }
                                    <span class="nav-profile-name">@headerName</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
                                    @if (User.Claims.Any(c => c.Type == "IsAdmin" && c.Value == "True"))
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-area="" asp-controller="Admin" asp-action="Index">Admin</a>
                                        </li>
                                    }
                                    @if (!User.Claims.Any(c => c.Type == "IsAdmin" && c.Value == "True"))
                                    {
                                        <li>
                                            <a class="dropdown-item" href="/Profile/@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value">My Profile</a>
                                        </li>
                                    }
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form method="post" asp-controller="Account" asp-action="Logout">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item">Sign out</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Account" asp-action="Login">Sign in</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Account" asp-action="Register">Sign up</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- Footer - HotComics Style -->
    <footer class="footer">
        <div class="container">
            <p>&copy; 2025 AnyComic. All rights reserved. | Developed by <strong>Pedro Luiz Tunin</strong></p>
        </div>
    </footer>

    <!-- Mobile Bottom Navigation -->
    <nav class="mobile-bottom-nav" id="mobileBottomNav">
        <a href="@Url.Action("Index", "Home")" class="mobile-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16">
                <path d="M8.354 1.146a.5.5 0 0 0-.708 0l-6 6A.5.5 0 0 0 1.5 7.5v7a.5.5 0 0 0 .5.5h4.5a.5.5 0 0 0 .5-.5v-4h2v4a.5.5 0 0 0 .5.5H14a.5.5 0 0 0 .5-.5v-7a.5.5 0 0 0-.146-.354L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293L8.354 1.146z"/>
            </svg>
            <span>Home</span>
        </a>
        <a href="@Url.Action("Index", "Manga")" class="mobile-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Manga" && ViewContext.RouteData.Values["action"]?.ToString() != "Favoritos" ? "active" : "")">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16">
                <path d="M1 2.828c.885-.37 2.154-.769 3.388-.893 1.33-.134 2.458.063 3.112.752v9.746c-.935-.53-2.12-.603-3.213-.493-1.18.12-2.37.461-3.287.811V2.828zm7.5-.141c.654-.689 1.782-.886 3.112-.752 1.234.124 2.503.523 3.388.893v9.923c-.918-.35-2.107-.692-3.287-.81-1.094-.111-2.278-.039-3.213.492V2.687zM8 1.783C7.015.936 5.587.81 4.287.94c-1.514.153-3.042.672-3.994 1.105A.5.5 0 0 0 0 2.5v11a.5.5 0 0 0 .707.455c.882-.4 2.303-.881 3.68-1.02 1.409-.142 2.59.087 3.223.877a.5.5 0 0 0 .78 0c.633-.79 1.814-1.019 3.222-.877 1.378.139 2.8.62 3.681 1.02A.5.5 0 0 0 16 13.5v-11a.5.5 0 0 0-.293-.455c-.952-.433-2.48-.952-3.994-1.105C10.413.809 8.985.936 8 1.783z"/>
            </svg>
            <span>Manga</span>
        </a>
        <a href="@Url.Action("Index", "Anime")" class="mobile-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Anime" ? "active" : "")">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16">
                <path d="M0 1a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H1a1 1 0 0 1-1-1V1zm4 0v6h8V1H4zm8 8H4v6h8V9zM1 1v2h2V1H1zm2 3H1v2h2V4zM1 7v2h2V7H1zm2 3H1v2h2v-2zm-2 3v2h2v-2H1zM15 1h-2v2h2V1zm-2 3v2h2V4h-2zm2 3h-2v2h2V7zm-2 3v2h2v-2h-2zm2 3h-2v2h2v-2zM6.79 5.093A.5.5 0 0 0 6 5.5v5a.5.5 0 0 0 .79.407l3.5-2.5a.5.5 0 0 0 0-.814l-3.5-2.5z"/>
            </svg>
            <span>Anime <span style="font-size:9px;font-weight:700;background:#ef2c2f;color:#fff;padding:1px 5px;border-radius:3px;vertical-align:middle;">BETA</span></span>
        </a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a href="@Url.Action("Login", "Account")" class="mobile-nav-item" id="mobileNavProfile" onclick="event.preventDefault(); document.getElementById('mobileProfileMenu').classList.toggle('open');">
                @if (!string.IsNullOrEmpty(headerPhoto))
                {
                    <img src="@headerPhoto" alt="@headerName" class="mobile-nav-avatar" />
                }
                else
                {
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0z"/>
                        <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8zm8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1z"/>
                    </svg>
                }
                <span>@headerName</span>
            </a>
        }
        else
        {
            <a href="@Url.Action("Login", "Account")" class="mobile-nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Login" ? "active" : "")">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M6 3.5a.5.5 0 0 1 .5-.5h8a.5.5 0 0 1 .5.5v9a.5.5 0 0 1-.5.5h-8a.5.5 0 0 1-.5-.5v-2a.5.5 0 0 0-1 0v2A1.5 1.5 0 0 0 6.5 14h8a1.5 1.5 0 0 0 1.5-1.5v-9A1.5 1.5 0 0 0 14.5 2h-8A1.5 1.5 0 0 0 5 3.5v2a.5.5 0 0 0 1 0v-2z"/>
                    <path fill-rule="evenodd" d="M11.854 8.354a.5.5 0 0 0 0-.708l-3-3a.5.5 0 1 0-.708.708L10.293 7.5H1.5a.5.5 0 0 0 0 1h8.793l-2.147 2.146a.5.5 0 0 0 .708.708l3-3z"/>
                </svg>
                <span>Sign in</span>
            </a>
        }
    </nav>

    <!-- Mobile Profile Popup Menu -->
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="mobile-profile-menu" id="mobileProfileMenu">
            <div class="mobile-profile-menu-backdrop" onclick="document.getElementById('mobileProfileMenu').classList.remove('open');"></div>
            <div class="mobile-profile-menu-content">
                <div class="mobile-profile-header">
                    @if (!string.IsNullOrEmpty(headerPhoto))
                    {
                        <img src="@headerPhoto" alt="@headerName" class="mobile-profile-avatar" />
                    }
                    else
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0z"/>
                            <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8zm8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1z"/>
                        </svg>
                    }
                    <span>@headerName</span>
                </div>
                <div class="mobile-profile-actions">
                    @if (User.Claims.Any(c => c.Type == "IsAdmin" && c.Value == "True"))
                    {
                        <a href="@Url.Action("Index", "Admin")" class="mobile-profile-action">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M9.405 1.05c-.413-1.4-2.397-1.4-2.81 0l-.1.34a1.464 1.464 0 0 1-2.105.872l-.31-.17c-1.283-.698-2.686.705-1.987 1.987l.169.311c.446.82.023 1.841-.872 2.105l-.34.1c-1.4.413-1.4 2.397 0 2.81l.34.1a1.464 1.464 0 0 1 .872 2.105l-.17.31c-.698 1.283.705 2.686 1.987 1.987l.311-.169a1.464 1.464 0 0 1 2.105.872l.1.34c.413 1.4 2.397 1.4 2.81 0l.1-.34a1.464 1.464 0 0 1 2.105-.872l.31.17c1.283.698 2.686-.705 1.987-1.987l-.169-.311a1.464 1.464 0 0 1 .872-2.105l.34-.1c1.4-.413 1.4-2.397 0-2.81l-.34-.1a1.464 1.464 0 0 1-.872-2.105l.17-.31c.698-1.283-.705-2.686-1.987-1.987l-.311.169a1.464 1.464 0 0 1-2.105-.872l-.1-.34zM8 10.93a2.929 2.929 0 1 1 0-5.86 2.929 2.929 0 0 1 0 5.858z"/>
                            </svg>
                            Admin
                        </a>
                    }
                    @if (!User.Claims.Any(c => c.Type == "IsAdmin" && c.Value == "True"))
                    {
                        <a href="/Profile/@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value" class="mobile-profile-action">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0z"/>
                                <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8zm8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1z"/>
                            </svg>
                            My Profile
                        </a>
                        <a href="@Url.Action("Favoritos", "Manga")" class="mobile-profile-action">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M1 2.828c.885-.37 2.154-.769 3.388-.893 1.33-.134 2.458.063 3.112.752v9.746c-.935-.53-2.12-.603-3.213-.493-1.18.12-2.37.461-3.287.811V2.828zm7.5-.141c.654-.689 1.782-.886 3.112-.752 1.234.124 2.503.523 3.388.893v9.923c-.918-.35-2.107-.692-3.287-.81-1.094-.111-2.278-.039-3.213.492V2.687zM8 1.783C7.015.936 5.587.81 4.287.94c-1.514.153-3.042.672-3.994 1.105A.5.5 0 0 0 0 2.5v11a.5.5 0 0 0 .707.455c.882-.4 2.303-.881 3.68-1.02 1.409-.142 2.59.087 3.223.877a.5.5 0 0 0 .78 0c.633-.79 1.814-1.019 3.222-.877 1.378.139 2.8.62 3.681 1.02A.5.5 0 0 0 16 13.5v-11a.5.5 0 0 0-.293-.455c-.952-.433-2.48-.952-3.994-1.105C10.413.809 8.985.936 8 1.783z"/>
                            </svg>
                            Manga Favorites
                        </a>
                        <a href="@Url.Action("Favoritos", "Anime")" class="mobile-profile-action">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                                <path d="m8 2.748-.717-.737C5.6.281 2.514.878 1.4 3.053c-.523 1.023-.641 2.5.314 4.385.92 1.815 2.834 3.989 6.286 6.357 3.452-2.368 5.365-4.542 6.286-6.357.955-1.886.838-3.362.314-4.385C13.486.878 10.4.28 8.717 2.01L8 2.748zM8 15C-7.333 4.868 3.279-3.04 7.824 1.143c.06.055.119.112.176.171a3.12 3.12 0 0 1 .176-.17C12.72-3.042 23.333 4.867 8 15z"/>
                            </svg>
                            Anime Favorites
                        </a>
                    }
                    <div class="mobile-profile-divider"></div>
                    <form method="post" asp-controller="Account" asp-action="Logout" style="margin: 0;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="mobile-profile-action mobile-profile-action-danger">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                                <path fill-rule="evenodd" d="M10 12.5a.5.5 0 0 1-.5.5h-8a.5.5 0 0 1-.5-.5v-9a.5.5 0 0 1 .5-.5h8a.5.5 0 0 1 .5.5v2a.5.5 0 0 0 1 0v-2A1.5 1.5 0 0 0 9.5 2h-8A1.5 1.5 0 0 0 0 3.5v9A1.5 1.5 0 0 0 1.5 14h8a1.5 1.5 0 0 0 1.5-1.5v-2a.5.5 0 0 0-1 0v2z"/>
                                <path fill-rule="evenodd" d="M15.854 8.354a.5.5 0 0 0 0-.708l-3-3a.5.5 0 0 0-.708.708L14.293 7.5H5.5a.5.5 0 0 0 0 1h8.793l-2.147 2.146a.5.5 0 0 0 .708.708l3-3z"/>
                            </svg>
                            Sign out
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Set dark theme (only theme supported)
        document.documentElement.setAttribute('data-theme', 'dark');
        localStorage.removeItem('theme');
    </script>

    <script>
        // Header live search (desktop and mobile manga autocomplete)
        (function () {
            const suggestUrl = '@Url.Action("Suggest", "Manga")';
            const detailsBase = '@Url.Action("Details", "Manga")';

            function escapeHtml(s) {
                return (s || '').replace(/[&<>"']/g, c =>
                    ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
            }

            document.querySelectorAll('[data-live-search]').forEach(function (wrap) {
                const input = wrap.querySelector('[data-search-input]');
                const dropdown = wrap.querySelector('[data-search-dropdown]');
                if (!input || !dropdown) return;

                let timer = null, lastQuery = '', items = [], activeIndex = -1;

                function setExpanded(expanded) {
                    input.setAttribute('aria-expanded', expanded ? 'true' : 'false');
                }

                function close() {
                    dropdown.classList.remove('open');
                    dropdown.innerHTML = '';
                    items = []; activeIndex = -1;
                    setExpanded(false);
                }

                function render(results) {
                    if (!results.length) {
                        dropdown.innerHTML = '<div class="header-search-empty" role="status">No manga found</div>';
                        dropdown.classList.add('open');
                        items = []; activeIndex = -1; setExpanded(true);
                        return;
                    }
                    dropdown.innerHTML = results.map(r => {
                        const cover = r.imagemCapa
                            ? '<img class="header-search-thumb" src="' + escapeHtml(r.imagemCapa) + '" alt="" loading="lazy">'
                            : '<span class="header-search-thumb"></span>';
                        return '<a class="header-search-item" role="option" href="' + detailsBase + '/' + r.id + '">' +
                            cover +
                            '<span class="header-search-info">' +
                                '<div class="header-search-title">' + escapeHtml(r.titulo) + '</div>' +
                                '<div class="header-search-author">' + escapeHtml(r.autor) + '</div>' +
                            '</span></a>';
                    }).join('');
                    dropdown.classList.add('open');
                    items = Array.from(dropdown.querySelectorAll('.header-search-item'));
                    activeIndex = -1; setExpanded(true);
                }

                async function doSearch(q) {
                    try {
                        const resp = await fetch(suggestUrl + '?term=' + encodeURIComponent(q));
                        if (!resp.ok) return;
                        const data = await resp.json();
                        if (input.value.trim() !== q) return;
                        render(data);
                    } catch (e) { /* ignore transient errors */ }
                }

                function updateActive() {
                    items.forEach((el, i) => {
                        const active = i === activeIndex;
                        el.classList.toggle('active', active);
                        el.setAttribute('aria-selected', active ? 'true' : 'false');
                    });
                    if (items[activeIndex]) items[activeIndex].scrollIntoView({ block: 'nearest' });
                }

                input.addEventListener('input', function () {
                    const q = input.value.trim();
                    if (q.length < 2) { close(); lastQuery = ''; return; }
                    if (q === lastQuery) return;
                    lastQuery = q;
                    clearTimeout(timer);
                    timer = setTimeout(() => doSearch(q), 250);
                });

                input.addEventListener('keydown', function (e) {
                    if (e.key === 'Escape') { close(); input.blur(); return; }
                    if (!dropdown.classList.contains('open') || !items.length) return;
                    if (e.key === 'ArrowDown') { e.preventDefault(); activeIndex = Math.min(activeIndex + 1, items.length - 1); updateActive(); }
                    else if (e.key === 'ArrowUp') { e.preventDefault(); activeIndex = Math.max(activeIndex - 1, 0); updateActive(); }
                    else if (e.key === 'Enter' && activeIndex >= 0) { e.preventDefault(); window.location.href = items[activeIndex].href; }
                });

                input.addEventListener('focus', function () {
                    if (items.length && input.value.trim().length >= 2) {
                        dropdown.classList.add('open'); setExpanded(true);
                    }
                });

                document.addEventListener('click', function (e) {
                    if (!wrap.contains(e.target)) close();
                });
            });

            const mobileToggle = document.querySelector('[data-mobile-search-toggle]');
            const mobileSearch = document.getElementById('mobileHeaderSearch');
            const mobileClose = mobileSearch?.querySelector('[data-mobile-search-close]');
            const mobileInput = mobileSearch?.querySelector('[data-search-input]');

            function setMobileSearch(open) {
                if (!mobileToggle || !mobileSearch) return;
                mobileSearch.classList.toggle('open', open);
                mobileToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
                mobileToggle.setAttribute('aria-label', open ? 'Close search' : 'Open search');
                if (open) window.setTimeout(() => mobileInput?.focus(), 80);
                else mobileInput?.blur();
            }

            mobileToggle?.addEventListener('click', function () {
                setMobileSearch(!mobileSearch.classList.contains('open'));
            });
            mobileClose?.addEventListener('click', function () {
                setMobileSearch(false);
                mobileToggle.focus();
            });
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && mobileSearch?.classList.contains('open')) setMobileSearch(false);
            });
            document.addEventListener('click', function (e) {
                if (mobileSearch?.classList.contains('open') &&
                    !mobileSearch.contains(e.target) && !mobileToggle?.contains(e.target)) {
                    setMobileSearch(false);
                }
            });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('/js/sw.js');
        }
    </script>
</body>
</html>
