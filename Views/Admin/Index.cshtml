@{
    ViewData["Title"] = "Admin Panel";
    var mangaTotal = (int)(ViewBag.MangaTotal ?? 0);
    var animeTotal = (int)(ViewBag.AnimeTotal ?? 0);
    var adminsTotal = (int)(ViewBag.AdminsTotal ?? 0);
    var bannersTotal = (int)(ViewBag.BannersTotal ?? 0);
}

<div class="page-container">
    <div class="admin-panel fade-in">
        <div class="mb-4 pb-3" style="border-bottom: 2px solid var(--primary-red);">
            <h1 class="page-title" style="margin-bottom: 5px;">Admin Panel</h1>
            <p class="page-subtitle" style="margin-bottom: 0;">Manage manga content and users</p>
        </div>

        <ul class="nav nav-tabs mb-4" id="adminTabs" role="tablist" style="border-bottom: 2px solid var(--border-color);">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" data-tab="mangas" data-url="@Url.Action("MangaList", "Admin")"
                        style="font-weight:600;padding:12px 24px;border:none;background:transparent;transition:all .2s ease;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16" style="vertical-align:text-top;margin-right:8px;"><path d="M1 2.828c.885-.37 2.154-.769 3.388-.893 1.33-.134 2.458.063 3.112.752v9.746c-.935-.53-2.12-.603-3.213-.493-1.18.12-2.37.461-3.287.811V2.828zm7.5-.141c.654-.689 1.782-.886 3.112-.752 1.234.124 2.503.523 3.388.893v9.923c-.918-.35-2.107-.692-3.287-.81-1.094-.111-2.278-.039-3.213.492V2.687zM8 1.783C7.015.936 5.587.81 4.287.94c-1.514.153-3.042.672-3.994 1.105A.5.5 0 0 0 0 2.5v11a.5.5 0 0 0 .707.455c.882-.4 2.303-.881 3.68-1.02 1.409-.142 2.59.087 3.223.877a.5.5 0 0 0 .78 0c.633-.79 1.814-1.019 3.222-.877 1.378.139 2.8.62 3.681 1.02A.5.5 0 0 0 16 13.5v-11a.5.5 0 0 0-.293-.455c-.952-.433-2.48-.952-3.994-1.105C10.413.809 8.985.936 8 1.783z"/></svg>
                    Manga (@mangaTotal)
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" data-tab="animes" data-url="@Url.Action("AnimeList", "Admin")"
                        style="font-weight:600;padding:12px 24px;border:none;background:transparent;transition:all .2s ease;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16" style="vertical-align:text-top;margin-right:8px;"><path d="M0 1a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H1a1 1 0 0 1-1-1V1zm4 0v6h8V1H4zm8 8H4v6h8V9zM1 1v2h2V1H1zm2 3H1v2h2V4zM1 7v2h2V7H1zm2 3H1v2h2v-2zm-2 3v2h2v-2H1zM15 1h-2v2h2V1zm-2 3v2h2V4h-2zm2 3h-2v2h2V7zm-2 3v2h2v-2h-2zm2 3h-2v2h2v-2zM6.79 5.093A.5.5 0 0 0 6 5.5v5a.5.5 0 0 0 .79.407l3.5-2.5a.5.5 0 0 0 0-.814l-3.5-2.5z"/></svg>
                    Anime (@animeTotal)
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" data-tab="admins" data-url="@Url.Action("AdminList", "Admin")"
                        style="font-weight:600;padding:12px 24px;border:none;background:transparent;transition:all .2s ease;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16" style="vertical-align:text-top;margin-right:8px;"><path d="M7 14s-1 0-1-1 1-4 5-4 5 3 5 4-1 1-1 1H7Zm4-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm-5.784 6A2.238 2.238 0 0 1 5 13c0-1.355.68-2.75 1.936-3.72A6.325 6.325 0 0 0 5 9c-4 0-5 3-5 4s1 1 1 1h4.216ZM4.5 8a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z"/></svg>
                    Admins (@adminsTotal)
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" data-tab="banners" data-url="@Url.Action("BannerList", "Admin")"
                        style="font-weight:600;padding:12px 24px;border:none;background:transparent;transition:all .2s ease;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16" style="vertical-align:text-top;margin-right:8px;"><path d="M6.002 5.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0z"/><path d="M2.002 1a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V3a2 2 0 0 0-2-2h-12zm12 1a1 1 0 0 1 1 1v6.5l-3.777-1.947a.5.5 0 0 0-.577.093l-3.71 3.71-2.66-1.772a.5.5 0 0 0-.63.062L1.002 12V3a1 1 0 0 1 1-1h12z"/></svg>
                    Banners (@bannersTotal)
                </button>
            </li>
        </ul>

        @if (ViewBag.Success != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <strong>Success!</strong> @ViewBag.Success
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <strong>Error!</strong> @ViewBag.Error
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (ViewBag.Warning != null)
        {
            <div class="alert alert-warning alert-dismissible fade show" role="alert">
                <strong>Warning!</strong> @ViewBag.Warning
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="tab-content" id="adminTabsContent">
            <div class="tab-pane fade show active" id="tab-mangas" role="tabpanel">
                @{ var mangas = ViewBag.Mangas as IEnumerable<AnyComic.Models.ViewModels.MangaListItem>; }
                @await Html.PartialAsync("_MangaTable", mangas)
            </div>
            <div class="tab-pane fade" id="tab-animes" role="tabpanel">
                <div class="text-center py-5 text-muted">Loading...</div>
            </div>
            <div class="tab-pane fade" id="tab-admins" role="tabpanel">
                <div class="text-center py-5 text-muted">Loading...</div>
            </div>
            <div class="tab-pane fade" id="tab-banners" role="tabpanel">
                <div class="text-center py-5 text-muted">Loading...</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .nav-tabs .nav-link.active {
            color: var(--primary-red) !important;
            border-bottom: 3px solid var(--primary-red) !important;
            background: transparent;
        }
        .nav-tabs .nav-link:hover {
            color: var(--primary-red) !important;
            border-bottom: 3px solid transparent;
        }
        .nav-tabs .nav-link {
            color: var(--text-primary) !important;
        }
        .admin-table tbody td {
            color: var(--text-primary) !important;
        }
        .admin-table tbody td[style*="color: #333"] {
            color: var(--text-primary) !important;
        }
        .admin-table tbody td[style*="color: #6c757d"] {
            color: var(--text-secondary) !important;
        }
        .admin-table tbody td span[style*="background-color: #f8f9fa"] {
            background-color: var(--bg-light) !important;
            color: var(--text-primary) !important;
        }
        .admin-table tbody td span[style*="background-color: #d4edda"] {
            background-color: rgba(40,167,69,.2) !important;
            color: #4caf50 !important;
        }
        .admin-table tbody td span[style*="background-color: #f8d7da"] {
            background-color: rgba(220,53,69,.2) !important;
            color: #f44336 !important;
        }
        .alert h4, .alert p { color: inherit !important; }
        .nav-tabs { border-bottom: 2px solid var(--border-color) !important; }
        .page-link-btn {
            min-width: 36px; padding: 6px 12px; text-align: center;
            border-radius: 6px; border: 1px solid var(--border-color);
            background: var(--bg-darker); color: var(--text-secondary);
            text-decoration: none; font-size: 13px; font-weight: 500;
            display: inline-block; transition: background .15s, border-color .15s, color .15s;
        }
        .page-link-btn:hover { border-color: var(--text-muted); background: rgba(255,255,255,.05); color: var(--text-primary); }
        .page-link-btn.active { background: var(--primary-red); border-color: var(--primary-red); color: #fff; pointer-events: none; }
    </style>

    <script>
        var loadedTabs = { mangas: true };

        function loadTab(tabId, url) {
            var pane = document.getElementById('tab-' + tabId);
            if (!pane) return;
            pane.innerHTML = '<div class="text-center py-5 text-muted">Loading...</div>';
            fetch(url)
                .then(r => r.text())
                .then(html => { pane.innerHTML = html; loadedTabs[tabId] = true; })
                .catch(() => { pane.innerHTML = '<div class="alert alert-danger">Failed to load. <a href="#" onclick="loadTab(\'' + tabId + '\',\'' + url + '\');return false;">Retry</a></div>'; });
        }

        document.querySelectorAll('#adminTabs [data-tab]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var tabId = this.getAttribute('data-tab');
                var url = this.getAttribute('data-url');

                // Update active states
                document.querySelectorAll('#adminTabs [data-tab]').forEach(b => b.classList.remove('active'));
                this.classList.add('active');

                document.querySelectorAll('#adminTabsContent .tab-pane').forEach(p => {
                    p.classList.remove('show', 'active');
                });
                var pane = document.getElementById('tab-' + tabId);
                if (pane) { pane.classList.add('show', 'active'); }

                // Load content if not already loaded
                if (!loadedTabs[tabId] && url) {
                    loadTab(tabId, url);
                }
            });
        });
    </script>
}
