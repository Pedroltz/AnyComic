@model IEnumerable<AnyComic.Models.Banner>

<div class="d-flex align-items-center mb-3">
    <a asp-controller="Admin" asp-action="CreateBanner" class="btn btn-primary ms-auto">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" style="vertical-align:text-top;margin-right:5px;"><path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/></svg>
        Add Banner
    </a>
</div>

@if (Model != null && Model.Any())
{
    <div class="table-responsive">
        <table class="admin-table table">
            <thead>
                <tr>
                    <th style="width:80px;">Preview</th>
                    <th>Title</th>
                    <th>Subtitle</th>
                    <th style="width:80px;">Order</th>
                    <th style="width:80px;">Active</th>
                    <th style="width:180px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var banner in Model)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(banner.ImagemUrl))
                            {
                                <img src="@banner.ImagemUrl" alt="@banner.Titulo" style="width:60px;height:34px;object-fit:cover;border-radius:4px;" loading="lazy">
                            }
                            else
                            {
                                <div class="bg-secondary d-flex align-items-center justify-content-center" style="width:60px;height:34px;border-radius:4px;font-size:9px;">-</div>
                            }
                        </td>
                        <td style="font-weight:600;">@(string.IsNullOrEmpty(banner.Titulo) ? "-" : banner.Titulo)</td>
                        <td style="font-size:14px;">@(string.IsNullOrEmpty(banner.Subtitulo) ? "-" : banner.Subtitulo)</td>
                        <td>@banner.Ordem</td>
                        <td>
                            @if (banner.Ativo)
                            {
                                <span style="background:rgba(40,167,69,.2);color:#4caf50;padding:3px 10px;border-radius:12px;font-size:12px;font-weight:600;">Active</span>
                            }
                            else
                            {
                                <span style="background:rgba(255,255,255,.06);padding:3px 10px;border-radius:12px;font-size:12px;font-weight:600;">Inactive</span>
                            }
                        </td>
                        <td>
                            <div class="btn-group" role="group">
                                <a asp-controller="Admin" asp-action="EditBanner" asp-route-id="@banner.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z"/></svg>
                                </a>
                                <a asp-controller="Admin" asp-action="DeleteBanner" asp-route-id="@banner.Id" class="btn btn-sm btn-outline-primary" title="Delete" style="color:#dc3545;border-color:#dc3545;">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5Zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5Zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6Z"/><path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1ZM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118ZM2.5 3h11V2h-11v1Z"/></svg>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info text-center" style="margin-top:40px;">
        <h4 style="font-weight:600;margin-bottom:10px;">No banners found</h4>
        <p style="margin-bottom:15px;">Start by creating your first banner for the carousel!</p>
        <a asp-controller="Admin" asp-action="CreateBanner" class="btn btn-primary">Create Banner</a>
    </div>
}
