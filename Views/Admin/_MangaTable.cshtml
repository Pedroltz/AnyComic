@model IEnumerable<AnyComic.Models.ViewModels.MangaListItem>
@{
    var total = (int)ViewBag.MangaTotal;
    var page = (int)ViewBag.MangaPage;
    var pageSize = (int)ViewBag.MangaPageSize;
    var totalPages = (int)Math.Ceiling((double)total / pageSize);
    var search = ViewBag.SearchManga as string ?? "";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <form method="get" class="d-flex" style="flex: 1; max-width: 400px;"
          onsubmit="loadTab('mangas','@Url.Action("MangaList","Admin")?search='+encodeURIComponent(this.search.value));return false;">
        <input type="text" name="search" class="form-control" placeholder="Search manga by title or author..." value="@search" style="border-radius: 4px 0 0 4px;">
        <button type="submit" class="btn btn-outline-primary" style="border-radius: 0 4px 4px 0; border-left: none;">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/></svg>
        </button>
    </form>
    <a asp-controller="Admin" asp-action="CreateManga" class="btn btn-primary ms-3">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" style="vertical-align:text-top;margin-right:5px;"><path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/></svg>
        Add Manga
    </a>
</div>

@if (Model != null && Model.Any())
{
    <div class="table-responsive">
        <table class="admin-table table">
            <thead>
                <tr>
                    <th style="width:80px;">Cover</th>
                    <th>Title</th>
                    <th>Author</th>
                    <th style="width:100px;">Pages</th>
                    <th style="width:120px;">Created</th>
                    <th style="width:220px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var manga in Model)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(manga.ImagemCapa))
                            {
                                <img src="@manga.ImagemCapa" alt="@manga.Titulo" style="width:50px;height:70px;object-fit:cover;border-radius:4px;" loading="lazy">
                            }
                            else
                            {
                                <div class="bg-secondary text-white d-flex align-items-center justify-content-center" style="width:50px;height:70px;font-size:10px;border-radius:4px;">No cover</div>
                            }
                        </td>
                        <td style="font-weight:600;">@manga.Titulo</td>
                        <td>@manga.Autor</td>
                        <td>
                            <span style="background:rgba(255,255,255,.06);padding:4px 10px;border-radius:12px;font-size:13px;font-weight:600;">
                                @manga.PaginasCount
                            </span>
                        </td>
                        <td style="font-size:13px;">@manga.DataCriacao.ToString("MMM dd, yyyy")</td>
                        <td>
                            <div class="btn-group" role="group">
                                <a asp-controller="Admin" asp-action="EditManga" asp-route-id="@manga.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z"/></svg>
                                </a>
                                <a asp-controller="Admin" asp-action="UploadPages" asp-route-id="@manga.Id" class="btn btn-sm btn-outline-primary" title="Manage Pages">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z"/><path d="M7.646 1.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1-.708.708L8.5 2.707V11.5a.5.5 0 0 1-1 0V2.707L5.354 4.854a.5.5 0 1 1-.708-.708l3-3z"/></svg>
                                </a>
                                <a asp-controller="Admin" asp-action="DeleteManga" asp-route-id="@manga.Id" class="btn btn-sm btn-outline-primary" title="Delete" style="color:#dc3545;border-color:#dc3545;">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5Zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5Zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6Z"/><path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1ZM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118ZM2.5 3h11V2h-11v1Z"/></svg>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (totalPages > 1)
    {
        <nav class="d-flex justify-content-center align-items-center gap-1 mt-3">
            @for (int i = 1; i <= totalPages; i++)
            {
                <a href="#" class="page-link-btn @(i == page ? "active" : "")"
                   onclick="loadTab('mangas','@Url.Action("MangaList","Admin")?search=@Uri.EscapeDataString(search)&page=@i');return false;">@i</a>
            }
            <span class="ms-2" style="font-size:13px;color:var(--text-secondary);">@total total</span>
        </nav>
    }
}
else
{
    <div class="alert alert-info text-center" style="margin-top:40px;">
        <h4 style="font-weight:600;margin-bottom:10px;">No manga found</h4>
        <p style="margin-bottom:15px;">@(string.IsNullOrEmpty(search) ? "Start by adding your first manga!" : "Try a different search term")</p>
        @if (string.IsNullOrEmpty(search))
        {
            <a asp-controller="Admin" asp-action="CreateManga" class="btn btn-primary">Create Manga</a>
        }
    </div>
}
